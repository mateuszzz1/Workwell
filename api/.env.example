# Copie este arquivo para .env e substitua os valores locais.
# Nunca envie o arquivo .env ao Git.

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/workwell"

# Porta da API e endereço do frontend (CORS)
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Segredo que assina os tokens de login (mínimo 32 caracteres).
# Em desenvolvimento pode ficar vazio (usa um valor padrão);
# em produção (NODE_ENV=production) é OBRIGATÓRIO definir um valor próprio.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_SECRET=""

# Validade do login, em horas
TOKEN_HORAS=8
